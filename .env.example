# =========================
# IPSEC-VPN Environment Configuration
# =========================
# Copy to .env and fill in values

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ipsecvpn
POSTGRES_PASSWORD=ipsecvpn_secret_2026
POSTGRES_DB=ipsecvpn
DATABASE_URL=postgresql://ipsecvpn:ipsecvpn_secret_2026@postgres:5432/ipsecvpn?sslmode=disable

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Go Backend ──
BACKEND_PORT=8080
AI_SERVICE_URL=http://ai-service:8000
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800
GIN_MODE=release
LOG_LEVEL=info

# ── Python AI Service ──
AI_SERVICE_PORT=8000
RULES_PATH=/app/rules/security-rules.yaml
MODEL_PATH=/app/models

# ── Frontend ──
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=3000
